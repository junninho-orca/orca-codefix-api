# Copy to .env and fill in. .env is gitignored — never commit the real file.

# Orca API token, sent verbatim as `Authorization: Token <value>`.
# Needs TWO separately-granted permissions:
#   - the ai-core remediation skill  -> generating the fix
#   - shiftleft write                -> opening the pull request
# A token with only the first will 403 at the PR step. See README.
ORCA_API_TOKEN=

# The full Authorization header value — this is what the script actually reads.
# Quote it: the value contains a space.
#   ORCA_AUTH="Token <your ORCA_API_TOKEN>"
# Or a browser session JWT instead: ORCA_AUTH="Bearer eyJ..."
ORCA_AUTH=

# Only needed behind a TLS-intercepting proxy, where Python's bundled CA store
# lacks the proxy root and every call dies with CERTIFICATE_VERIFY_FAILED.
#   security find-certificate -a -p /Library/Keychains/System.keychain > ca.pem
SSL_CERT_FILE=
