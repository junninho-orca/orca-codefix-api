# Copy to .env and fill in. .env is gitignored — never commit the real file.
#
# The CLI reads this file directly. deploy.sh also reads it, and copies
# ORCA_API_TOKEN and WEBHOOK_SECRET into Secret Manager for the Cloud Function;
# nothing else here is passed to the deployed function.

# ---------------------------------------------------------------- credentials

# Orca API token, sent as `Authorization: Token <value>`.
# Needs TWO separately-granted permissions:
#   - the ai-core remediation skill  -> generating the fix
#   - shiftleft write                -> opening the pull request
# A token with only the first will 403 at the PR step. See README.
ORCA_API_TOKEN=

# Optional override: the full Authorization header value, used verbatim and
# taking precedence over ORCA_API_TOKEN. Quote it — the value contains a space.
#   ORCA_AUTH="Token <your ORCA_API_TOKEN>"
# Or a browser session JWT instead: ORCA_AUTH="Bearer eyJ..."
ORCA_AUTH=

# Shared secret Orca must present on every webhook request, in the
# X-Orca-Webhook-Token header. The function rejects everything without it, so
# this is the only thing standing between the internet and your repositories.
# Leave blank and deploy.sh generates a strong one for you.
WEBHOOK_SECRET=

# --------------------------------------------------------- function behaviour

# false (default) generates the fix and reports it without touching the repo.
# true opens real pull requests. deploy.sh defaults this to true.
CREATE_PR=false

# Optional coarse second net, OFF by default — and best left off. Matches
# substrings against the alert's type and category fields.
#
# This is not the real filter. The flow already gates structurally: an alert is
# processed only if it resolves to code (its asset is a repository, or a cloud
# resource with an IaC code origin), which is decided before anything billable
# and needs no list of categories. CSPM has hundreds of them, so a name-based
# allowlist would both miss new ones and silently drop valid ones.
#
# Scope alerts in the Orca automation rule instead. Use this only to narrow
# temporarily, e.g. ALERT_TYPE_ALLOWLIST=sast
ALERT_TYPE_ALLOWLIST=

# Header Orca sends the shared secret in. Change only if you configured a
# different header name in the Orca webhook template.
WEBHOOK_SECRET_HEADER=X-Orca-Webhook-Token

# Most alerts to process in one request, so a large batch can't run for hours.
MAX_ALERTS_PER_REQUEST=10

# How many recent alert ids to remember per instance, to stop an Orca retry
# opening a second pull request. 0 disables the guard.
DEDUPE_WINDOW=512

# Set true ONLY for local testing — it disables the shared-secret check.
ALLOW_UNAUTHENTICATED=

# ------------------------------------------------------------------ local CLI

# Only needed behind a TLS-intercepting proxy, where Python's bundled CA store
# lacks the proxy root and every call dies with CERTIFICATE_VERIFY_FAILED.
# Not relevant to the deployed function.
#   security find-certificate -a -p /Library/Keychains/System.keychain > ca.pem
SSL_CERT_FILE=
